local function clickBtn(b)
    if not b then return false end
    local ok = false
    if getconnections then
        for _, n in ipairs({"MouseButton1Down", "MouseButton1Click", "Activated"}) do
            pcall(function()
                local sig = b[n]
                if not sig then return end
                for _, c in pairs(getconnections(sig)) do
                    if c.Function then task.spawn(c.Function) ok = true
                    elseif c.Fire then c:Fire() ok = true end
                end
            end)
        end
    end
    if firesignal then
        pcall(function()
            firesignal(b.MouseButton1Down)
            firesignal(b.MouseButton1Click)
            ok = true
        end)
    end
    return ok
end

local function doRhythm(g)
    local r = g.rhythm
    if not r or not r.Visible then return end
    if not rhythmEv or not rhythmEv.Parent then rhythmEv = evs:FindFirstChild("RhythmHit") end
    for _, lane in ipairs({"A", "S", "D"}) do
        local lf = r:FindFirstChild("Progression" .. lane)
        if lf then
            local bf = lf:FindFirstChild("BarFrame")
            local targetY = bf and bf.Position.Y.Scale or 0.85
            local best, note = 0.11, nil
            for _, ch in ipairs(lf:GetChildren()) do
                if ch.Name == "Note_FX" and ch:IsA("GuiObject") and ch.Visible and not hitNotes[ch] then
                    local d = math.abs(ch.Position.Y.Scale - targetY)
                    if d < best then best = d note = ch end
                end
            end
            if note then
                hitNotes[note] = true
                local b = lf:FindFirstChild("Button") or lf:FindFirstChildWhichIsA("TextButton", true) or lf:FindFirstChildWhichIsA("ImageButton", true)
                clickBtn(b)
                local kc = keyMap[lane]
                if kc then
                    pcall(function()
                        vim:SendKeyEvent(true, kc, false, game)
                        task.delay(0.02, function() vim:SendKeyEvent(false, kc, false, game) end)
                    end)
                end
                if rhythmEv then pcall(function() rhythmEv:FireServer("hit") end) end
            end
        end
    end
end

local function doPhase2(g)
    local b = g.boss
    if not b or not b.Visible then
        if #p2hist > 0 then table.clear(p2hist) end
        return
    end
    local bar = b:FindFirstChild("Bar")
    local hb = b:FindFirstChild("Hitbox")
    if not bar or not hb then return end
    local now = os.clock()
    local bw = bar.Size.X.Scale
    local cx = bar.Position.X.Scale + bw * (0.5 - bar.AnchorPoint.X)
    local hw = hb.Size.X.Scale
    local hl = hb.Position.X.Scale - hw * hb.AnchorPoint.X
    table.insert(p2hist, {t = now, x = cx})
    while #p2hist > 1 and now - p2hist[1].t > 0.12 do table.remove(p2hist, 1) end
    if now - lastP2 < 0.12 then return end
    local ex = cx
    for i = #p2hist, 1, -1 do
        if p2hist[i].t <= now - 0.03 then ex = p2hist[i].x break end
    end
    local bad = b:FindFirstChild("HitboxBad")
    if bad and bad.Visible then
        local bbw = bad.Size.X.Scale
        local bl = bad.Position.X.Scale - bbw * bad.AnchorPoint.X
        if ex >= bl and ex <= bl + bbw then return end
    end
    local pd = hw * 0.2
    if ex >= hl - pd and ex <= hl + hw + pd then
        lastP2 = now
        if not clickBtn(g.mFish) then
            pcall(function()
                vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.delay(0.015, function() vim:SendMouseButtonEvent(0, 0, 0, false, game, 0) end)
            end)
        end
    end
end

