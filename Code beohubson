local function aS(tx, mn, mx, gt, st)
    local f = Instance.new("Frame", cont)
    f.Size = UDim2.new(1, -4, 0, 50)
    f.BackgroundColor3 = cd
    f.BorderSizePixel = 0
    f.LayoutOrder = nN()
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)

    local l = Instance.new("TextLabel", f)
    l.Size = UDim2.new(1, -20, 0, 20)
    l.Position = UDim2.new(0, 10, 0, 4)
    l.BackgroundTransparency = 1
    l.Text = tx .. " : " .. tostring(gt())
    l.TextColor3 = Color3.fromRGB(230, 235, 245)
    l.Font = Enum.Font.Gotham
    l.TextSize = 12
    l.TextXAlignment = Enum.TextXAlignment.Left

    local br = Instance.new("Frame", f)
    br.Size = UDim2.new(1, -20, 0, 4)
    br.Position = UDim2.new(0, 10, 1, -12)
    br.BackgroundColor3 = Color3.fromRGB(40, 45, 58)
    br.BorderSizePixel = 0
    Instance.new("UICorner", br).CornerRadius = UDim.new(1, 0)

    local fl = Instance.new("Frame", br)
    fl.Size = UDim2.new((gt() - mn) / (mx - mn), 0, 1, 0)
    fl.BackgroundColor3 = ac
    fl.BorderSizePixel = 0
    Instance.new("UICorner", fl).CornerRadius = UDim.new(1, 0)

    local db = Instance.new("TextButton", br)
    db.Size = UDim2.new(1, 0, 1, 0)
    db.BackgroundTransparency = 1
    db.Text = ""
    db.MouseButton1Down:Connect(function()
        local dg = true
        local c1, c2
        c1 = uis.InputChanged:Connect(function(i)
            if dg and (i.UserInputType == Enum.UserInputType.MouseMovement
                or i.UserInputType == Enum.UserInputType.Touch) then
                local rl = math.clamp(
                    (i.Position.X - br.AbsolutePosition.X) / math.max(br.AbsoluteSize.X, 1),
                    0, 1
                )
                local vl = math.floor(mn + (mx - mn) * rl + 0.5)
                fl.Size = UDim2.new(rl, 0, 1, 0)
                l.Text = tx .. " : " .. vl
                st(vl)
                sv()
            end
        end)
        c2 = uis.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
                or i.UserInputType == Enum.UserInputType.Touch then
                dg = false
                if c1 then c1:Disconnect() end
                if c2 then c2:Disconnect() end
            end
        end)
    end)
end

