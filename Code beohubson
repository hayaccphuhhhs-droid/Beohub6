local getupval = (debug and debug.getupvalue) or getupvalue

local function stepBoss()
    if not bossBar or not bossBar.Visible then
        if #phase2Hist > 0 then table.clear(phase2Hist) end
        return
    end
    local bar = bossBar:FindFirstChild("Bar")
    local hb = bossBar:FindFirstChild("Hitbox")
    if not bar or not hb then return end
    local barW = bar.Size.X.Scale
    local barX = bar.Position.X.Scale + barW * (0.5 - bar.AnchorPoint.X)
    local hbW = hb.Size.X.Scale
    local hbL = hb.Position.X.Scale - hbW * hb.AnchorPoint.X
    local now = os.clock()
    table.insert(phase2Hist, { t = now, x = barX })
    while #phase2Hist > 1 and (now - phase2Hist[1].t) > 0.15 do
        table.remove(phase2Hist, 1)
    end
    local gotUpval = false
    local clickFn = nil
    if getconnections and getupval and mobileBtn then
        pcall(function()
            for _, c in pairs(getconnections(mobileBtn.MouseButton1Down)) do
                local fn = c.Function and getupval(c.Function, 1)
                if type(fn) == "function" then
                    clickFn = fn
                    local u1 = getupval(fn, 1)
                    local u2 = getupval(fn, 2)
                    local u3 = getupval(fn, 3)
                    local u4 = getupval(fn, 4)
                    local u5 = getupval(fn, 5)
                    local u6 = getupval(fn, 6)
                    local u7 = getupval(fn, 7)
                    local u8 = getupval(fn, 8)
                    local u9 = getupval(fn, 9)
                    if u1 == true and type(u2) == "number" and type(u3) == "number" and type(u4) == "number" and type(u5) == "number" and type(u6) == "number" and type(u7) == "number" and type(u8) == "number" and type(u9) == "number" then
                        if math.abs(u8 - hbW) < 0.005 and math.abs(u9 - hbL) < 0.005 then
                            gotUpval = true
                            if now - u2 >= 0.035 and now - lastPhase2Hit >= 0.035 then
                                local calc = (now - 0.025 - u3) % u4 * u5
                                if u6 < calc then calc = u6 * 2 - calc end
                                local finalX = u7 + calc
                                local pad = u8 * 0.3
                                if finalX >= (u9 - pad * 0.8) and finalX <= (u9 + u8 + pad * 0.8) then
                                    lastPhase2Hit = now
                                    fn(false)
                                end
                            end
                        end
                        break
                    end
                end
            end
        end)
    end
    if gotUpval then return end
    if now - lastPhase2Hit < 0.04 then return end
    local evalX = barX
    local tgt = now - 0.041
    for i = #phase2Hist, 1, -1 do
        if phase2Hist[i].t <= tgt then evalX = phase2Hist[i].x break end
    end
    local pad = hbW * 0.2
    local bad = bossBar:FindFirstChild("HitboxBad")
    if bad and bad.Visible then
        local bw = bad.Size.X.Scale
        local bl = bad.Position.X.Scale - bw * bad.AnchorPoint.X
        if evalX >= (bl - 0.01) and evalX <= (bl + bw + 0.01) then return end
    end
    if evalX >= (hbL - pad) and evalX <= (hbL + hbW + pad) then
        lastPhase2Hit = now
        local ok = false
        if clickFn then pcall(function() clickFn(false) ok = true end) end
        if not ok and mobileBtn then
            if getconnections then
                pcall(function()
                    for _, c in pairs(getconnections(mobileBtn.MouseButton1Down)) do
                        if c.Function then task.spawn(c.Function) ok = true
                        elseif c.Fire then c:Fire() ok = true end
                    end
                end)
            end
            if not ok and firesignal then
                pcall(function() firesignal(mobileBtn.MouseButton1Down) ok = true end)
            end
        end
        if not ok then
            pcall(function()
                VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.delay(0.01, function() VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0) end)
            end)
        end
    end
end

local function stepRhythm()
    if not rhythmGui or not rhythmGui.Visible then return end
    local now = os.clock()
    if now - lastScan < 0.025 then return end
    lastScan = now
    for _, lane in ipairs(lanes) do
        if now - (lastHit[lane] or 0) >= 0.05 then
            local laneF = rhythmGui:FindFirstChild("Progression" .. lane)
            if laneF then
                local barF = laneF:FindFirstChild("BarFrame")
                local tgtY = barF and barF.Position.Y.Scale or 0.85
                local note = nil
                local best = 0.18
                for _, c in ipairs(laneF:GetChildren()) do
                    if c.Name == "Note_FX" and c:IsA("GuiObject") and c.Visible then
                        local d = math.abs(c.Position.Y.Scale - tgtY)
                        if d <= best then best = d note = c end
                    end
                end
                if note then
                    lastHit[lane] = now
                    local b = laneF:FindFirstChild("Button")
                    if b then fireBtn(b) end
                    if note.Parent ~= nil then
                        local kc = keys[lane]
                        if kc then
                            pcall(function()
                                VIM:SendKeyEvent(true, kc, false, game)
                                task.delay(0.02, function() VIM:SendKeyEvent(false, kc, false, game) end)
                            end)
                        end
                    end
                    if note.Parent ~= nil and best <= 0.1 and RhythmHitEvent then
                        pcall(function()
                            note:Destroy()
                            RhythmHitEvent:FireServer("hit")
                        end)
                    end
                end
            end
        end
    end
end

