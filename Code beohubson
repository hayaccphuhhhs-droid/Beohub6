local function clk(b)
    if not b then return false end
    local ok = false
    if getconnections then
        for _, n in ipairs({"MouseButton1Down", "MouseButton1Click", "Activated"}) do
            pcall(function()
                local s = b[n]
                if not s then return end
                for _, c in pairs(getconnections(s)) do
                    if c.Function then task.spawn(c.Function) ok = true
                    elseif c.Fire then c:Fire() ok = true end
                end
            end)
        end
    end
    if firesignal then
        pcall(function()
            firesignal(b.MouseButton1Down)
            firesignal(b.MouseButton1Click)
            ok = true
        end)
    end
    return ok
end

local function doR(g)
    local r = g.rhythm
    if not r or not r.Visible then return end
    if not rh or not rh.Parent then rh = Events:FindFirstChild("RhythmHit") end
    for _, ln in ipairs({"A", "S", "D"}) do
        local lf = r:FindFirstChild("Progression" .. ln)
        if lf then
            local bf = lf:FindFirstChild("BarFrame")
            local ty = bf and bf.Position.Y.Scale or 0.85
            local bt, nt = 0.11, nil
            for _, ch in ipairs(lf:GetChildren()) do
                if ch.Name == "Note_FX" and ch:IsA("GuiObject") and ch.Visible and not hN[ch] then
                    local d = math.abs(ch.Position.Y.Scale - ty)
                    if d < bt then bt = d nt = ch end
                end
            end
            if nt then
                hN[nt] = true
                local b = lf:FindFirstChild("Button") or lf:FindFirstChildWhichIsA("TextButton", true) or lf:FindFirstChildWhichIsA("ImageButton", true)
                clk(b)
                local kc = kM[ln]
                if kc then
                    pcall(function()
                        VIM:SendKeyEvent(true, kc, false, game)
                        task.delay(0.02, function() VIM:SendKeyEvent(false, kc, false, game) end)
                    end)
                end
                if rh then pcall(function() rh:FireServer("hit") end) end
            end
        end
    end
end

local function doP(g)
    local b = g.boss
    if not b or not b.Visible then
        if #p2h > 0 then table.clear(p2h) end
        return
    end
    local br = b:FindFirstChild("Bar")
    local hb = b:FindFirstChild("Hitbox")
    if not br or not hb then return end
    local nw = os.clock()
    local bw = br.Size.X.Scale
    local cx = br.Position.X.Scale + bw * (0.5 - br.AnchorPoint.X)
    local hw = hb.Size.X.Scale
    local hl = hb.Position.X.Scale - hw * hb.AnchorPoint.X
    table.insert(p2h, {t = nw, x = cx})
    while #p2h > 1 and nw - p2h[1].t > 0.12 do table.remove(p2h, 1) end
    if nw - lp2 < 0.12 then return end
    local ex = cx
    for i = #p2h, 1, -1 do
        if p2h[i].t <= nw - 0.03 then ex = p2h[i].x break end
    end
    local bad = b:FindFirstChild("HitboxBad")
    if bad and bad.Visible then
        local bbw = bad.Size.X.Scale
        local bl = bad.Position.X.Scale - bbw * bad.AnchorPoint.X
        if ex >= bl and ex <= bl + bbw then return end
    end
    local pd = hw * 0.2
    if ex >= hl - pd and ex <= hl + hw + pd then
        lp2 = nw
        if not clk(g.mFish) then
            pcall(function()
                VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.delay(0.015, function() VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0) end)
            end)
        end
    end
end

