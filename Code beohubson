local function saveCfg()
    pcall(function()
        if not isfolder(cf) then makefolder(cf) end
        local d = {}
        for k, v in pairs(getgenv()) do
            if type(v) == "boolean" or type(v) == "number" or type(v) == "string" then
                if k ~= "AntiAdmin" and k ~= "AdminIn" then d[k] = v end
            end
        end
        writefile(cfPath, hs:JSONEncode(d))
    end)
end

local function addToggle(t, get, set)
    local r = Instance.new("Frame", cont)
    r.Size = UDim2.new(1, -4, 0, 34)
    r.BackgroundColor3 = cd
    r.BorderSizePixel = 0
    r.LayoutOrder = getNum()
    Instance.new("UICorner", r).CornerRadius = UDim.new(0, 8)
    local l = Instance.new("TextLabel", r)
    l.Size = UDim2.new(1, -70, 1, 0)
    l.Position = UDim2.new(0, 12, 0, 0)
    l.BackgroundTransparency = 1
    l.Text = t
    l.TextColor3 = Color3.fromRGB(230, 235, 245)
    l.Font = Enum.Font.Gotham
    l.TextSize = 13
    l.TextXAlignment = Enum.TextXAlignment.Left
    local b = Instance.new("TextButton", r)
    b.Size = UDim2.new(0, 48, 0, 24)
    b.Position = UDim2.new(1, -56, 0.5, -12)
    b.BorderSizePixel = 0
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
    local function update()
        if get() then
            b.Text = "ON"
            b.BackgroundColor3 = ac
            b.TextColor3 = Color3.fromRGB(10, 14, 20)
        else
            b.Text = "OFF"
            b.BackgroundColor3 = Color3.fromRGB(40, 45, 58)
            b.TextColor3 = Color3.fromRGB(140, 150, 165)
        end
    end
    update()
    b.MouseButton1Click:Connect(function()
        set(not get())
        update()
        saveCfg()
    end)
end

