local skills = {"UseSkill","CastSkill","Skill","ActivateSkill","PlaySkill","SkillActivate","DoSkill"}
local function getSkRemote()
    local e = rep:FindFirstChild("Events") or rep
    for _, n in ipairs(skills) do
        local r = e:FindFirstChild(n, true)
        if r and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then return r end
    end
end
local skRem = getSkRemote()
local function cast(k)
    if skRem then pcall(function() skRem:FireServer(k) end) return end
    pcall(function()
        vim:SendKeyEvent(true, Enum.KeyCode[k], false, game)
        task.wait(0.05)
        vim:SendKeyEvent(false, Enum.KeyCode[k], false, game)
    end)
end

task.spawn(function()
    while true do
        task.wait(0.5 + math.random() * 0.3)
        pcall(function()
            local c = me.Character
            if not c then return end
            local h = c:FindFirstChildOfClass("Humanoid")
            if not h or h.Health <= 0 then return end
            local function gap() task.wait(0.15 + math.random() * 0.05) end
            if getgenv().AllSkill then
