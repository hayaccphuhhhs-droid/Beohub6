    local ok = false
    if getconnections then
        for _, n in ipairs({"MouseButton1Down", "MouseButton1Click", "Activated"}) do
            pcall(function()
                local sig = btn[n]
                if not sig then return end
                for _, c in pairs(getconnections(sig)) do
                    if c.Function then task.spawn(c.Function) ok = true
                    elseif c.Fire then c:Fire() ok = true end
                end
            end)
        end
    end
    if not ok and firesignal then
        pcall(function()
            firesignal(btn.MouseButton1Down)
            firesignal(btn.MouseButton1Click)
            ok = true
        end)
    end
    return ok
end

local function StepRhythm()
    if not RhythmGui or not RhythmGui.Visible then return end
    local now = os.clock()
    for _, lane in ipairs({"A", "S", "D"}) do
        if now - (lastRhythmHit[lane] or 0) >= HIT_CD then
            local laneFrame = RhythmGui:FindFirstChild("Progression" .. lane)
            if laneFrame then
                local barF = laneFrame:FindFirstChild("BarFrame")
                local targetY = barF and barF.Position.Y.Scale or 0.85
                local best, note = 0.07, nil
                for _, ch in ipairs(laneFrame:GetChildren()) do
                    if ch.Name == "Note_FX" and ch:IsA("GuiObject") and ch.Visible then
                        local d = math.abs(ch.Position.Y.Scale - targetY)
                        if d <= best then best = d note = ch end
                    end
                end
                if note then
                    lastRhythmHit[lane] = now
                    local btn = laneFrame:FindFirstChild("Button")
                        or laneFrame:FindFirstChildWhichIsA("TextButton", true)
                    triggerBtn(btn)
                    local kc = rhythmKeyMap[lane]
                    if kc then
                        pcall(function()
                            VIM:SendKeyEvent(true, kc, false, game)
                            task.delay(0.02, function()
                                VIM:SendKeyEvent(false, kc, false, game)
                            end)
                        end)
                    end
                    if RhythmHitEvent and best <= 0.07 then
                        pcall(function() RhythmHitEvent:FireServer("hit") end)
                    end
                end
            end
        end
    end
end

local function StepPhase2()
    if not BossFightBar or not BossFightBar.Visible then
        if #phase2History > 0 then table.clear(phase2History) end
        return
    end
    local bar = BossFightBar:FindFirstChild("Bar")
    local hitbox = BossFightBar:FindFirstChild("Hitbox")
    if not bar or not hitbox then return end
    local now = os.clock()
    local barW = bar.Size.X.Scale
    local barCenter = bar.Position.X.Scale + barW * (0.5 - bar.AnchorPoint.X)
    local hbW = hitbox.Size.X.Scale
    local hbLeft = hitbox.Position.X.Scale - hbW * hitbox.AnchorPoint.X
    table.insert(phase2History, { t = now, x = barCenter })
    while #phase2History > 1 and (now - phase2History[1].t) > 0.15 do
        table.remove(phase2History, 1)
    end
    if now - lastPhase2Hit < HIT_CD then return end
    local evalX = barCenter
    for i = #phase2History, 1, -1 do
        if phase2History[i].t <= now - 0.035 then
            evalX = phase2History[i].x
            break
        end
    end
    local bad = BossFightBar:FindFirstChild("HitboxBad")
    if bad and bad.Visible then
        local bw = bad.Size.X.Scale
        local bl = bad.Position.X.Scale - bw * bad.AnchorPoint.X
        if evalX >= bl and evalX <= bl + bw then return end
    end
    local pad = hbW * 0.22
    if evalX >= (hbLeft - pad) and evalX <= (hbLeft + hbW + pad) then
        lastPhase2Hit = now
        if not triggerBtn(MobileFishingBtn) then
            pcall(function()
                VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.delay(0.015, function()
                    VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                end)
            end)
        end
    end
end

