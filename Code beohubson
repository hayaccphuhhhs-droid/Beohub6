            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") then
                    local typ, color = GetNPCType(obj)
                    if typ == "Taoist" and getgenv().ESP_Taoist then CreateESP(obj, typ, color)
                    elseif typ == "Maoshan" and getgenv().ESP_Maoshan then CreateESP(obj, typ, color) end
                end
