-- esp npc
local function CreateESP(npc, typ, color)
    if not npc or not npc:IsA("Model") then return end
    if getgenv().ESPList[npc] then return end
    local hrp = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
    if not hrp then return end

    local hl = Instance.new("Highlight")
    hl.Adornee = npc
    hl.FillTransparency = 1
    hl.OutlineColor = color
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = npc

    local bill = Instance.new("BillboardGui")
    bill.Size = UDim2.fromOffset(200, 50)
    bill.StudsOffset = Vector3.new(0, 4, 0)
    bill.AlwaysOnTop = true
    bill.Adornee = hrp
    bill.Parent = npc

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size = UDim2.new(1, 0, 1, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text = npc.Name
    nameLbl.TextColor3 = color
    nameLbl.TextStrokeTransparency = 0
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextSize = 18
    nameLbl.Parent = bill

    local distLbl = Instance.new("TextLabel")
    distLbl.Size = UDim2.new(1, 0, 0, 20)
    distLbl.Position = UDim2.new(0, 0, 1, 0)
    distLbl.BackgroundTransparency = 1
    distLbl.Text = "0m"
    distLbl.TextColor3 = Color3.fromRGB(255, 255, 0)
    distLbl.TextStrokeTransparency = 0
    distLbl.Font = Enum.Font.GothamBold
    distLbl.TextSize = 14
    distLbl.Parent = bill

    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not hrp or not hrp.Parent then
            conn:Disconnect()
            return
        end
        local my = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if my then
            distLbl.Text = math.floor((hrp.Position - my.Position).Magnitude) .. "m"
        end
    end)

    getgenv().ESPList[npc] = {
        highlight = hl,
        billboard = bill,
        connection = conn,
        type = typ
    }
end

local function GetNPCType(obj)
    if not obj:IsA("Model") then return end
    if obj == lp.Character then return end
    if Players:GetPlayerFromCharacter(obj) then return end
    local n = string.lower(obj.Name)
    if n:find("taoist") then return "Taoist", Color3.fromRGB(255, 165, 0) end
    if n:find("maoshan") then return "Maoshan", Color3.fromRGB(180, 0, 255) end
end

task.spawn(function()
    while task.wait(1) do
        if getgenv().ESP_Taoist or getgenv().ESP_Maoshan then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") then
                    local typ, color = GetNPCType(obj)
                    if typ == "Taoist" and getgenv().ESP_Taoist then
                        CreateESP(obj, typ, color)
                    elseif typ == "Maoshan" and getgenv().ESP_Maoshan then
                        CreateESP(obj, typ, color)
                    end
                end
            end
        end
    end
end)

-- esp player
local function CreatePlayerESP(plr)
    if not plr or plr == lp then return end
    if getgenv().ESPPlayerList[plr] then return end
    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local bill = Instance.new("BillboardGui")
    bill.Size = UDim2.fromOffset(200, 30)
    bill.StudsOffset = Vector3.new(0, 3.5, 0)
    bill.AlwaysOnTop = true
    bill.Adornee = hrp
    bill.Parent = char

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = plr.Name
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.TextStrokeTransparency = 0
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 16
    lbl.Parent = bill

    local hl = Instance.new("Highlight")
    hl.Adornee = char
    hl.FillTransparency = 1
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.OutlineTransparency = 0.3
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = char

    getgenv().ESPPlayerList[plr] = {billboard = bill, highlight = hl}
end

local function RemovePlayerESP(plr)
    local data = getgenv().ESPPlayerList[plr]
    if data then
        if data.billboard then data.billboard:Destroy() end
        if data.highlight then data.highlight:Destroy() end
        getgenv().ESPPlayerList[plr] = nil
    end
end

