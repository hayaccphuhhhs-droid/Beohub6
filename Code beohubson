local function show(name)
    wipe()
    for n, b in pairs(tabs) do
        b.BackgroundColor3 = (n == name) and Color3.fromRGB(255, 140, 50) or Color3.fromRGB(50, 32, 24)
        b.TextColor3 = (n == name) and Color3.fromRGB(20, 10, 5) or Color3.fromRGB(220, 200, 180)
