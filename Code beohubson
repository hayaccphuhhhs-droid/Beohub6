local skillRemotes = { "UseSkill", "CastSkill", "Skill", "ActivateSkill" }
local function findSkillRemote()
    for _, n in ipairs(skillRemotes) do
        local r = evs:FindFirstChild(n, true)
        if r and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then
            return r
        end
    end
    return nil
end
local skR = findSkillRemote()

local function useSk(k)
    if skR then
        pcall(function() skR:FireServer(k) end)
        return
    end
    pcall(function()
        VIM:SendKeyEvent(true, Enum.KeyCode[k], false, game)
        task.wait(0.05)
        VIM:SendKeyEvent(false, Enum.KeyCode[k], false, game)
    end)
end

