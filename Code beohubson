local function fireGuiButton(btn)
    if not btn then return false end
    local ok = false
    if getconnections then
        for _, sigName in ipairs({"MouseButton1Down", "MouseButton1Click", "Activated"}) do
            pcall(function()
                local sig = btn[sigName]
                if not sig then return end
                for _, conn in pairs(getconnections(sig)) do
                    if conn.Function then task.spawn(conn.Function) ok = true
                    elseif conn.Fire then conn:Fire() ok = true end
                end
            end)
        end
    end
    if not ok and firesignal then
        pcall(function()
            firesignal(btn.MouseButton1Down)
            firesignal(btn.MouseButton1Click)
            ok = true
        end)
    end
    return ok
end

local function StepRhythm(ui)
    local rhythm = ui:FindFirstChild("Rhythm")
    if not rhythm or not rhythm.Visible then return end
    if not RhythmHitEvent or not RhythmHitEvent.Parent then
        RhythmHitEvent = Events and Events:FindFirstChild("RhythmHit")
    end
    local now = os.clock()
    for _, lane in ipairs(rhythmLanes) do
        if (now - (lastRhythmHit[lane] or 0)) >= 0.05 then
            local laneFrame = rhythm:FindFirstChild("Progression" .. lane)
            if laneFrame then
                local barFrame = laneFrame:FindFirstChild("BarFrame")
                local targetY = barFrame and barFrame.Position.Y.Scale or 0.85
                local bestDist, targetNote = 0.08, nil
                for _, child in ipairs(laneFrame:GetChildren()) do
                    if child.Name == "Note_FX" and child:IsA("GuiObject") and child.Visible then
                        local dist = math.abs(child.Position.Y.Scale - targetY)
                        if dist <= bestDist then bestDist = dist targetNote = child end
                    end
                end
                if not targetNote then
                    for _, child in ipairs(laneFrame:GetDescendants()) do
                        if child:IsA("GuiObject") and child.Visible then
                            local n = string.lower(child.Name)
                            if n:find("note") then
                                local dist = math.abs(child.Position.Y.Scale - targetY)
                                if dist <= bestDist then bestDist = dist targetNote = child end
                            end
                        end
                    end
                end
                if targetNote then
                    lastRhythmHit[lane] = now
                    local btn = laneFrame:FindFirstChild("Button")
                        or laneFrame:FindFirstChildWhichIsA("TextButton", true)
                        or laneFrame:FindFirstChildWhichIsA("ImageButton", true)
                    fireGuiButton(btn)
                    local kc = rhythmKeyMap[lane]
                    if kc then
                        pcall(function()
                            VIM:SendKeyEvent(true, kc, false, game)
                            task.delay(0.02, function() VIM:SendKeyEvent(false, kc, false, game) end)
                        end)
                    end
                    if RhythmHitEvent and bestDist <= 0.08 then
                        pcall(function() RhythmHitEvent:FireServer("hit") end)
                    end
                end
            end
        end
    end
end

local function StepPhase2(ui)
    local bossBar = ui:FindFirstChild("BossFightBar")
    if not bossBar or not bossBar.Visible then
        if #phase2History > 0 then table.clear(phase2History) end
        return
    end
    local bar = bossBar:FindFirstChild("Bar")
    local hitbox = bossBar:FindFirstChild("Hitbox")
    if not bar or not hitbox then return end
    local now = os.clock()
    local barW = bar.Size.X.Scale
    local barCenter = bar.Position.X.Scale + barW * (0.5 - bar.AnchorPoint.X)
    local hbW = hitbox.Size.X.Scale
    local hbLeft = hitbox.Position.X.Scale - hbW * hitbox.AnchorPoint.X
    table.insert(phase2History, { t = now, x = barCenter })
    while #phase2History > 1 and (now - phase2History[1].t) > 0.12 do
        table.remove(phase2History, 1)
    end
    if now - lastPhase2Hit < 0.06 then return end
    local evalX = barCenter
    local targetTime = now - 0.03
    for i = #phase2History, 1, -1 do
        if phase2History[i].t <= targetTime then
            evalX = phase2History[i].x
            break
        end
    end
    local bad = bossBar:FindFirstChild("HitboxBad")
    if bad and bad.Visible then
        local bw = bad.Size.X.Scale
        local bl = bad.Position.X.Scale - bw * bad.AnchorPoint.X
        if evalX >= (bl - 0.01) and evalX <= (bl + bw + 0.01) then return end
    end
    local pad = hbW * 0.25
    if evalX >= (hbLeft - pad) and evalX <= (hbLeft + hbW + pad) then
        lastPhase2Hit = now
        local main = lp.PlayerGui:FindFirstChild("MainGui")
        local mobile = main and main:FindFirstChild("Mobile")
        local mFish = mobile and mobile:FindFirstChild("Fishing")
        if not fireGuiButton(mFish) then
            pcall(function()
                VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.delay(0.015, function()
                    VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                end)
            end)
        end
    end
end

