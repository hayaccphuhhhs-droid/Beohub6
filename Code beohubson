local WaterParts = {}
local OriginalWater = {}

local function FindWater()
    WaterParts = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower() == "water" then
            table.insert(WaterParts, obj)
        end
    end
end

local function EnableWater()
    FindWater()
    for _, w in ipairs(WaterParts) do
        OriginalWater[w] = w.CanCollide
        w.CanCollide = true
    end
end

local function DisableWater()
    for w, old in pairs(OriginalWater) do
        if w and w.Parent then
            w.CanCollide = old
        end
    end
    OriginalWater = {}
end

