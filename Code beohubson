            if v:IsA("ModuleScript") then
                local ok, d = pcall(require, v)
                if ok and type(d) == "table" and d.Ingredient and d.Type == "Fishing Rod" then
                    hasR = true
                    btn("Craft " .. v.Name, function()
                        RS.Events.CraftRod:FireServer(v.Name)
                    end)
                end
            end
        end
    end
    if not hasR then sec("(No craftable rod)") end
end

