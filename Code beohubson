local eT = {}
local function clrE()
    for m, d in pairs(eT) do
        if d.h then d.h:Destroy() end
        if d.b then d.b:Destroy() end
        eT[m] = nil
    end
end
local function isJunk(n)
    for _, x in ipairs({ "rod", "weapon", "tool", "fishing", "can cau" }) do
        if n:find(x, 1, true) then return true end
    end
    return false
end
local function mkE(model, label, color)
    if not model or eT[model] then return end
    local h = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if not h then return end
    local hl = Instance.new("Highlight")
    hl.Adornee = model
    hl.FillTransparency = 1
    hl.OutlineColor = color
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = model
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.fromOffset(140, 32)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Adornee = h
    bb.Parent = model
    local tx = Instance.new("TextLabel", bb)
    tx.Size = UDim2.new(1, 0, 1, 0)
    tx.BackgroundTransparency = 1
    tx.Text = label
    tx.TextColor3 = color
    tx.TextStrokeTransparency = 0.3
    tx.Font = Enum.Font.GothamBold
    tx.TextSize = 12
    eT[model] = { h = hl, b = bb }
end

task.spawn(function()
    while task.wait(1) do
        local wT, wM = getgenv().ESP_T, getgenv().ESP_M
        if not wT and not wM then
            clrE()
        else
            for _, o in ipairs(workspace:GetDescendants()) do
                if o:IsA("Model") and o ~= me.Character and not Players:GetPlayerFromCharacter(o) then
                    local n = string.lower(o.Name)
                    if not isJunk(n) and o:FindFirstChildOfClass("Humanoid") then
                        if wT and n:find("taoist", 1, true) then
                            mkE(o, "Taoist", Color3.fromRGB(255, 160, 40))
                        elseif wM and n:find("maoshan", 1, true) then
                            mkE(o, "Maoshan", Color3.fromRGB(170, 40, 255))
                        end
                    end
                end
            end
            for m, d in pairs(eT) do
                local n = string.lower(m.Name)
                local hm = m:FindFirstChildOfClass("Humanoid")
                local rm = not m.Parent or (hm and hm.Health <= 0)
                    or (n:find("taoist", 1, true) and not wT)
                    or (n:find("maoshan", 1, true) and not wM)
                if rm then
                    if d.h then d.h:Destroy() end
                    if d.b then d.b:Destroy() end
                    eT[m] = nil
                end
            end
        end

        if getgenv().ESP_P then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= me and p.Character and not getgenv().ESPPlayerList[p] then
                    local h = p.Character:FindFirstChild("HumanoidRootPart")
                    local head = p.Character:FindFirstChild("Head")
                    if h then
                        local hl = Instance.new("Highlight")
                        hl.Adornee = p.Character
                        hl.FillTransparency = 1
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.Parent = p.Character
                        local bb = Instance.new("BillboardGui")
                        bb.Size = UDim2.fromOffset(140, 32)
                        bb.StudsOffset = Vector3.new(0, 2.4, 0)
                        bb.AlwaysOnTop = true
                        bb.Adornee = head or h
                        bb.Parent = p.Character
                        local tx = Instance.new("TextLabel", bb)
                        tx.Size = UDim2.new(1, 0, 1, 0)
                        tx.BackgroundTransparency = 1
                        tx.Text = p.DisplayName
                        tx.TextColor3 = Color3.fromRGB(255, 255, 255)
                        tx.TextStrokeTransparency = 0
                        tx.Font = Enum.Font.GothamBold
                        tx.TextSize = 12
                        getgenv().ESPPlayerList[p] = { hl = hl, bill = bb }
                    end
                end
            end
        else
            for p, d in pairs(getgenv().ESPPlayerList) do
                if d.hl then d.hl:Destroy() end
                if d.bill then d.bill:Destroy() end
                getgenv().ESPPlayerList[p] = nil
            end
        end
    end
end)

