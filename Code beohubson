local function skillRow()
    local row = Instance.new("Frame", Content)
    row.Size = UDim2.new(1, -4, 0, 34)
    row.BackgroundColor3 = CARD
    row.BorderSizePixel = 0
    row.LayoutOrder = getNextOrder()
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
    
    local keys = {"Z", "X", "C", "V"}
    for i, k in ipairs(keys) do
        local btn = Instance.new("TextButton", row)
        btn.Size = UDim2.new(0, 50, 0, 24)
        btn.Position = UDim2.new(0, 12 + (i-1)*56, 0.5, -12)
        btn.BorderSizePixel = 0
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 12
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        
        local function refresh()
            local active = getgenv()["Beo_Skill_"..k]
            if active then
                btn.Text = k .. " : ON"
                btn.BackgroundColor3 = ACCENT
                btn.TextColor3 = Color3.fromRGB(10, 14, 20)
            else
                btn.Text = k .. " : OFF"
                btn.BackgroundColor3 = Color3.fromRGB(40, 45, 58)
                btn.TextColor3 = Color3.fromRGB(140, 150, 165)
            end
        end
        refresh()
        btn.MouseButton1Click:Connect(function()
            getgenv()["Beo_Skill_"..k] = not getgenv()["Beo_Skill_"..k]
            refresh()
        end)
    end
end

