local function ckB(b)
    if not b then return false end
    local ok = false
    if getconnections then
        for _, n in ipairs({"MouseButton1Down", "MouseButton1Click", "Activated"}) do
            pcall(function()
                local s = b[n]
                if not s then return end
                for _, c in pairs(getconnections(s)) do
                    if c.Function then
                        task.spawn(c.Function)
                        ok = true
                    elseif c.Fire then
                        c:Fire()
                        ok = true
                    end
                end
            end)
        end
    end
    if firesignal then
        pcall(function()
            firesignal(b.MouseButton1Down)
            firesignal(b.MouseButton1Click)
            ok = true
        end)
    end
    return ok
end

local function dRh(g)
    local rr = g.rh
    if not rr or not rr.Visible then return end
    if not rhE or not rhE.Parent then
        rhE = ev:FindFirstChild("RhythmHit")
    end

    for _, ln in ipairs({"A", "S", "D"}) do
        local lf = rr:FindFirstChild("Progression" .. ln)
        if lf then
            local bf = lf:FindFirstChild("BarFrame")
            local tY = bf and bf.Position.Y.Scale or 0.85
            local bst, nt = 0.11, nil

            for _, ch in ipairs(lf:GetChildren()) do
                if ch.Name == "Note_FX" and ch:IsA("GuiObject")
                    and ch.Visible and not ht[ch] then
                    local dd = math.abs(ch.Position.Y.Scale - tY)
                    if dd < bst then
                        bst = dd
                        nt = ch
                    end
                end
            end

            if nt then
                ht[nt] = true
                local b = lf:FindFirstChild("Button")
                    or lf:FindFirstChildWhichIsA("TextButton", true)
                    or lf:FindFirstChildWhichIsA("ImageButton", true)
                ckB(b)

                local kc = kM[ln]
                if kc then
                    pcall(function()
                        vim:SendKeyEvent(true, kc, false, game)
                        task.delay(0.02, function()
                            vim:SendKeyEvent(false, kc, false, game)
                        end)
                    end)
                end
                if rhE then
                    pcall(function() rhE:FireServer("hit") end)
                end
            end
        end
    end
end

local function dP2(g)
    local b = g.bs
    if not b or not b.Visible then
        if #ph > 0 then table.clear(ph) end
        return
    end

    local br = b:FindFirstChild("Bar")
    local hb = b:FindFirstChild("Hitbox")
    if not br or not hb then return end

    local nw = os.clock()
    local bw = br.Size.X.Scale
    local cx = br.Position.X.Scale + bw * (0.5 - br.AnchorPoint.X)
    local hw = hb.Size.X.Scale
    local hl = hb.Position.X.Scale - hw * hb.AnchorPoint.X

    table.insert(ph, {t = nw, x = cx})
    while #ph > 1 and nw - ph[1].t > 0.12 do
        table.remove(ph, 1)
    end
    if nw - lp2 < 0.12 then return end

    local ex = cx
    for i = #ph, 1, -1 do
        if ph[i].t <= nw - 0.03 then
            ex = ph[i].x
            break
        end
    end

    local bd = b:FindFirstChild("HitboxBad")
    if bd and bd.Visible then
        local bbw = bd.Size.X.Scale
        local bl = bd.Position.X.Scale - bbw * bd.AnchorPoint.X
        if ex >= bl and ex <= bl + bbw then return end
    end

    local pd = hw * 0.2
    if ex >= hl - pd and ex <= hl + hw + pd then
        lp2 = nw
        if not ckB(g.mf) then
            pcall(function()
                vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.delay(0.015, function()
                    vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                end)
            end)
        end
    end
end

