                local ok, d = pcall(require, v)
                if ok and type(d) == "table" and not d.Ingredient then
                    btn("Buy " .. v.Name, function()
                        local be = RS.Events:FindFirstChild("BuyBait") or RS.Events:FindFirstChild("Bait")
                        if be then
                            be:FireServer(v.Name, getgenv().BuyBaitAmount)
                        else
                            RS.Events.CraftBait:FireServer(v.Name, getgenv().BuyBaitAmount)
                        end
                    end)
                end
            end
        end
    end

    sec("CRAFT BAIT")
    local hasB = false
    if bF then
        for _, v in ipairs(bF:GetChildren()) do
            if v:IsA("ModuleScript") then
                local ok, d = pcall(require, v)
                if ok and type(d) == "table" and d.Ingredient then
                    hasB = true
                    btn("Craft " .. v.Name, function()
                        RS.Events.CraftBait:FireServer(v.Name, 10)
                    end)
                end
            end
        end
    end
    if not hasB then sec("(No craftable bait)") end

    sec("CRAFT ROD")
