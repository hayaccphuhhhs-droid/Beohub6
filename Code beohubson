local uP = rep:FindFirstChild("Events") and rep.Events:FindFirstChild("UpdateFishProgression")
local cP = UDim2.new(0.5, 0, 0.5, 0)
local lk, pc2, bb = nil, nil, nil

local function lkB()
    if lk or not getgenv().HoldBar then return end
    local g = me.PlayerGui:FindFirstChild("MainGui")
    local fu = g and g:FindFirstChild("Fishing")
    if not fu or not fu.Visible then return end
    local b = fu:FindFirstChild("BarFrame") and fu.BarFrame:FindFirstChild("Bar")
    if not b then return end

    lk = true
    local c = me.Character
    if c then
        pcall(function()
            if (tonumber(c:GetAttribute("GuildPower")) or 0) < 99999999 then
                c:SetAttribute("GuildPower", 99999999)
            end
            local rp = c:FindFirstChild("Stats") and c.Stats:FindFirstChild("RodPower")
            if rp then
                local o = rp.Value
                rp.Value = o + 1
                rp.Value = o
            end
        end)
    end

    pcall(function()
        b.AnchorPoint = Vector2.new(0.5, 0.5)
        b:TweenPosition(cP, Enum.EasingDirection.InOut, Enum.EasingStyle.Linear, 0, true)
        b.Position = cP
    end)
    lk = false
end

local function bdB()
    local g = me.PlayerGui:FindFirstChild("MainGui")
    local fu = g and g:FindFirstChild("Fishing")
    if not fu or not fu.Visible then return end
    local b = fu:FindFirstChild("BarFrame") and fu.BarFrame:FindFirstChild("Bar")
    if not b then return end

    if b ~= bb then
        if pc2 then pcall(function() pc2:Disconnect() end) end
        bb = b
        pc2 = b:GetPropertyChangedSignal("Position"):Connect(function()
            if lk or not getgenv().HoldBar then return end
            if b.Position.X.Scale ~= 0.5 or b.Position.Y.Scale ~= 0.5 then
                lkB()
            end
        end)
    end
end

