local remoteNames = {"UseSkill","CastSkill","Skill","ActivateSkill","PlaySkill","SkillActivate","DoSkill"}
local function getSkillRemote()
    local ev = RS:FindFirstChild("Events") or RS
    for _, n in ipairs(remoteNames) do
        local r = ev:FindFirstChild(n, true)
        if r and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then return r end
    end
end
local skRemote = getSkillRemote()
local function castSkill(k)
    if skRemote then pcall(function() skRemote:FireServer(k) end) return end
    pcall(function()
        VIM:SendKeyEvent(true, Enum.KeyCode[k], false, game)
        task.wait(0.05)
        VIM:SendKeyEvent(false, Enum.KeyCode[k], false, game)
    end)
end

