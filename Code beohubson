    pcall(function()
        local gui = lp.PlayerGui:FindFirstChild("MainGui")
        if not gui then return end
        local fishingUI = gui:FindFirstChild("Fishing")
        if not fishingUI or not fishingUI.Visible then return end
        local barFrame = fishingUI:FindFirstChild("BarFrame")
        if barFrame then
            local bar = barFrame:FindFirstChild("Bar")
            if bar then
                bar.Position = UDim2.new(0.5, 0, bar.Position.Y.Scale, 0)
            end
        end
        if tick() - lastHoldFire >= (0.18 + math.random() * 0.08) then
            lastHoldFire = tick()
            if RS.Events and RS.Events:FindFirstChild("Fishing") then
                RS.Events.Fishing:FireServer("1")
            end
        end
    end)
end)

local OriginalWater = {}
task.spawn(function()
    local last = false
    while task.wait(0.3) do
        local on = getgenv().WalkOnWater
        if on and not last then
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj.Name:lower() == "water" then
                    OriginalWater[obj] = obj.CanCollide
                    obj.CanCollide = true
                end
            end
        elseif not on and last then
            for w, old in pairs(OriginalWater) do
                if w and w.Parent then w.CanCollide = old end
            end
            OriginalWater = {}
        end
        last = on
    end
end)

