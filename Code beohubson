-- ===== AUTO MINIGAME (HIT MANH) =====
local RhythmHitEvent = Events and Events:FindFirstChild("RhythmHit")
local rhythmLanes = {"A", "S", "D"}
local rhythmKeyMap = { A = Enum.KeyCode.A, S = Enum.KeyCode.S, D = Enum.KeyCode.D }
local lastRhythmHit = { A = 0, S = 0, D = 0 }
local lastPhase2Hit = 0

local function getFishingUI()
    local main = lp.PlayerGui:FindFirstChild("MainGui")
    return main and main:FindFirstChild("Fishing")
end

local function fireGuiButton(btn)
    if not btn then return false end
    local ok = false
    if getconnections then
        for _, sigName in ipairs({"MouseButton1Click", "Activated", "MouseButton1Down"}) do
            pcall(function()
                local sig = btn[sigName]
                if sig then
                    for _, conn in pairs(getconnections(sig)) do
                        if conn.Function then
                            task.spawn(conn.Function)
                            ok = true
                        elseif conn.Fire then
                            conn:Fire()
                            ok = true
                        end
                    end
                end
            end)
        end
    end
    if firesignal then
        pcall(function()
            firesignal(btn.MouseButton1Click)
            firesignal(btn.MouseButton1Down)
            ok = true
        end)
    end
    return ok
end

local function StepRhythm(ui)
    local rhythm = ui:FindFirstChild("Rhythm")
    if not rhythm or not rhythm.Visible then return end
    if not RhythmHitEvent then
        RhythmHitEvent = Events and Events:FindFirstChild("RhythmHit")
    end
    local now = os.clock()
    for _, lane in ipairs(rhythmLanes) do
        if now - (lastRhythmHit[lane] or 0) < 0.06 then continue end
        local laneFrame = rhythm:FindFirstChild("Progression" .. lane)
        if not laneFrame then continue end
        local barFrame = laneFrame:FindFirstChild("BarFrame")
        local targetY = barFrame and barFrame.Position.Y.Scale or 0.85
        local bestDist, note = 0.18, nil
        for _, child in ipairs(laneFrame:GetDescendants()) do
            if child:IsA("GuiObject") and child.Visible then
                local n = string.lower(child.Name)
                if n:find("note") or n:find("fx") or n == "note_fx" then
                    local y = child.Position.Y.Scale
                    local dist = math.abs(y - targetY)
                    if dist < bestDist then
                        bestDist = dist
                        note = child
                    end
                end
            end
        end
        if note then
            lastRhythmHit[lane] = now
            local btn = laneFrame:FindFirstChild("Button") or laneFrame:FindFirstChildWhichIsA("TextButton", true)
            fireGuiButton(btn)
            local kc = rhythmKeyMap[lane]
            if kc then
                pcall(function()
                    VIM:SendKeyEvent(true, kc, false, game)
                    task.delay(0.025, function()
                        VIM:SendKeyEvent(false, kc, false, game)
                    end)
                end)
            end
            if RhythmHitEvent then
                pcall(function() RhythmHitEvent:FireServer("hit") end)
            end
        end
    end
end

local function StepPhase2(ui)
    local bossBar = ui:FindFirstChild("BossFightBar")
    if not bossBar or not bossBar.Visible then return end
    local bar = bossBar:FindFirstChild("Bar")
    local hitbox = bossBar:FindFirstChild("Hitbox")
    if not bar or not hitbox then return end
    local now = os.clock()
    if now - lastPhase2Hit < 0.07 then return end
    local barW = bar.Size.X.Scale
    local barCenter = bar.Position.X.Scale + barW * (0.5 - bar.AnchorPoint.X)
    local hbW = hitbox.Size.X.Scale
    local hbLeft = hitbox.Position.X.Scale - hbW * hitbox.AnchorPoint.X
    local pad = hbW * 0.35
    local bad = bossBar:FindFirstChild("HitboxBad")
    if bad and bad.Visible then
        local bw = bad.Size.X.Scale
        local bl = bad.Position.X.Scale - bw * bad.AnchorPoint.X
        if barCenter >= bl and barCenter <= bl + bw then return end
    end
    if barCenter >= (hbLeft - pad) and barCenter <= (hbLeft + hbW + pad) then
        lastPhase2Hit = now
        local main = lp.PlayerGui:FindFirstChild("MainGui")
        local mobile = main and main:FindFirstChild("Mobile")
        local mFish = mobile and mobile:FindFirstChild("Fishing")
        if not fireGuiButton(mFish) then
            pcall(function()
                VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.delay(0.02, function()
                    VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                end)
            end)
        end
    end
end

RunService.Heartbeat:Connect(function()
    if not getgenv().Beo_AutoMiniGame then return end
    pcall(function()
        local ui = getFishingUI()
        if not ui or not ui.Visible then return end
        StepRhythm(ui)
        StepPhase2(ui)
    end)
end)