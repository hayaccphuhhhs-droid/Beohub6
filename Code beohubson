local function CreateESP(npc, typ, color)
    if not npc or not npc:IsA("Model") or getgenv().ESPList[npc] then return end
    local hrp = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
    if not hrp then return end
    local hl = Instance.new("Highlight")
    hl.Adornee = npc
    hl.FillTransparency = 1
    hl.OutlineColor = color
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = npc
    local bill = Instance.new("BillboardGui")
    bill.Size = UDim2.fromOffset(200, 50)
    bill.StudsOffset = Vector3.new(0, 4, 0)
    bill.AlwaysOnTop = true
    bill.Adornee = hrp
    bill.Parent = npc
    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size = UDim2.new(1, 0, 1, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text = npc.Name
    nameLbl.TextColor3 = color
    nameLbl.TextStrokeTransparency = 0
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextSize = 18
    nameLbl.Parent = bill
    local distLbl = Instance.new("TextLabel")
    distLbl.Size = UDim2.new(1, 0, 0, 20)
    distLbl.Position = UDim2.new(0, 0, 1, 0)
    distLbl.BackgroundTransparency = 1
    distLbl.Text = "0m"
    distLbl.TextColor3 = Color3.fromRGB(255, 255, 0)
    distLbl.TextStrokeTransparency = 0
    distLbl.Font = Enum.Font.GothamBold
    distLbl.TextSize = 14
    distLbl.Parent = bill
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not hrp or not hrp.Parent then conn:Disconnect() return end
        local my = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if my then distLbl.Text = math.floor((hrp.Position - my.Position).Magnitude) .. "m" end
    end)
    getgenv().ESPList[npc] = { highlight = hl, billboard = bill, connection = conn, type = typ }
end

local function GetNPCType(obj)
    if not obj:IsA("Model") or obj == lp.Character or Players:GetPlayerFromCharacter(obj) then return end
    local n = string.lower(obj.Name)
    if n:find("taoist") then return "Taoist", Color3.fromRGB(255, 165, 0) end
    if n:find("maoshan") then return "Maoshan", Color3.fromRGB(180, 0, 255) end
end

task.spawn(function()
    while task.wait(1) do
