    b.Text = name
    b.TextColor3 = Color3.fromRGB(230, 230, 230)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.BorderSizePixel = 0
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    tabBtns[name] = b
    b.MouseButton1Click:Connect(function() selectTab(name) end)
    makePage(name)
end

