local skn = {"UseSkill", "CastSkill", "Skill", "ActivateSkill", "PlaySkill", "SkillActivate", "DoSkill"}

local function gSk()
    local e = rep:FindFirstChild("Events") or rep
    for _, n in ipairs(skn) do
        local rr = e:FindFirstChild(n, true)
        if rr and (rr:IsA("RemoteEvent") or rr:IsA("RemoteFunction")) then
            return rr
        end
    end
end

local skR = gSk()

local function cst(k)
    if skR then
        pcall(function() skR:FireServer(k) end)
        return
    end
    pcall(function()
        vim:SendKeyEvent(true, Enum.KeyCode[k], false, game)
        task.wait(0.05)
        vim:SendKeyEvent(false, Enum.KeyCode[k], false, game)
    end)
end

