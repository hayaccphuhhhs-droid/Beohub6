local PossibleRemotes = {"UseSkill","CastSkill","Skill","ActivateSkill","PlaySkill","SkillActivate","DoSkill"}
local function findSkillRemote()
    local events = RS:FindFirstChild("Events") or RS
    for _, name in ipairs(PossibleRemotes) do
        local r = events:FindFirstChild(name, true)
        if r and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then return r end
    end
end
local skillRemote = findSkillRemote()
local function useSkill(slot)
    if skillRemote then pcall(function() skillRemote:FireServer(slot) end) return end
    pcall(function()
        VIM:SendKeyEvent(true, Enum.KeyCode[slot], false, game)
        task.wait(0.05)
        VIM:SendKeyEvent(false, Enum.KeyCode[slot], false, game)
    end)
end

