    tx.Text = npc.Name
    tx.TextColor3 = cl
    tx.TextStrokeTransparency = 0.2
    tx.Font = Enum.Font.GothamBold
    tx.TextSize = 13

    getgenv().ESPList[npc] = {hl = hl, bill = bb2, typ = ty}
end

