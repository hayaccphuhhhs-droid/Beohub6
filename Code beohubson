local RhythmHitEvent = Events and Events:FindFirstChild("RhythmHit")
local rhythmLanes = {"A", "S", "D"}
local rhythmKeyMap = { A = Enum.KeyCode.A, S = Enum.KeyCode.S, D = Enum.KeyCode.D }
local lastRhythmHit = { A = 0, S = 0, D = 0 }
local lastPhase2Hit = 0
local phase2History = {}

local function getFishingUI()
