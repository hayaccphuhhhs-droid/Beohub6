local function lockBar()
    if locking then return end
    local g = me.PlayerGui:FindFirstChild("MainGui")
    local fUI = g and g:FindFirstChild("Fishing")
    if not fUI or not fUI.Visible then return end
    local bF = fUI:FindFirstChild("BarFrame")
    local b = bF and bF:FindFirstChild("Bar")
    if not b then return end
    if not getgenv().HoldBar then return end
    locking = true
    local c = me.Character
    if c then
        pcall(function()
            if (tonumber(c:GetAttribute("GuildPower")) or 0) < 99999999 then
                c:SetAttribute("GuildPower", 99999999)
            end
            local stats = c:FindFirstChild("Stats")
            local rp = stats and stats:FindFirstChild("RodPower")
            if rp then
                local o = rp.Value
                rp.Value = o + 1
                rp.Value = o
            end
        end)
    end
    pcall(function()
        b:TweenPosition(centerPos, Enum.EasingDirection.InOut, Enum.EasingStyle.Linear, 0, true)
        b.Position = centerPos
    end)
    locking = false
end

local function bindBar()
    local g = me.PlayerGui:FindFirstChild("MainGui")
    local fUI = g and g:FindFirstChild("Fishing")
    if not fUI or not fUI.Visible then return end
    local bF = fUI:FindFirstChild("BarFrame")
    local b = bF and bF:FindFirstChild("Bar")
    if not b then return end
    if b ~= boundBar then
        if posConn then
            pcall(function() posConn:Disconnect() end)
            posConn = nil
        end
        boundBar = b
        posConn = b:GetPropertyChangedSignal("Position"):Connect(function()
            if not locking and getgenv().HoldBar and b.Position.X.Scale ~= 0.5 then
                lockBar()
            end
        end)
    end
end

